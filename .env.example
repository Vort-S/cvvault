# Copy to .env.local; never commit a real value
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SESSION_SECRET=replace-with-64-random-hex-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=replace-with-private-blob-store-token
# Optional reset email provider integration; default is a non-enumerating stub
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Separate test Neon branch, NEVER production
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST-HOST/neondb?sslmode=require
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=
